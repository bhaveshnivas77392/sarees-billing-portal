// START GENAI
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN_IN
  ADJUSTMENT
}

enum PaymentMode {
  CASH
  UPI
  CARD
  SPLIT
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  address   String?
  createdAt DateTime @default(now()) @map("created_at")

  users          User[]
  stocks         Stock[]
  stockMovements StockMovement[]
  sales          Sale[]
  transfersOut   TransferRequest[] @relation("TransfersOut")
  transfersIn    TransferRequest[] @relation("TransfersIn")
  returns        ReturnRecord[]
  dayClosures    DayClosure[]

  @@map("branches")
}

/// Mirrors a Supabase Auth user (id = auth.users.id). branchId is null for OWNER, who sees all branches.
model User {
  id        String   @id
  email     String   @unique
  name      String
  role      Role
  branchId  String?  @map("branch_id")
  createdAt DateTime @default(now()) @map("created_at")

  branch         Branch?           @relation(fields: [branchId], references: [id])
  stockMovements StockMovement[]
  sales          Sale[]
  transfers      TransferRequest[]
  processedReturns ReturnRecord[]
  dayClosures    DayClosure[]

  @@map("users")
}

model Saree {
  id           String   @id @default(uuid())
  sku          String   @unique
  name         String
  fabric       String?
  color        String?
  category     String?
  costPrice    Decimal  @map("cost_price") @db.Decimal(10, 2)
  sellingPrice Decimal  @map("selling_price") @db.Decimal(10, 2)
  imageUrl     String?  @map("image_url")
  createdAt    DateTime @default(now()) @map("created_at")

  stocks           Stock[]
  stockMovements   StockMovement[]
  saleItems        SaleItem[]
  transferRequests TransferRequest[]
  returnItems      ReturnItem[]

  @@map("sarees")
}

/// One row per saree+branch holding the current on-hand quantity.
model Stock {
  id        String   @id @default(uuid())
  sareeId   String   @map("saree_id")
  branchId  String   @map("branch_id")
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  saree  Saree  @relation(fields: [sareeId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([sareeId, branchId])
  @@map("stocks")
}

/// Append-only audit trail; Stock.quantity is always derivable by summing these, so it can never silently drift.
model StockMovement {
  id        String            @id @default(uuid())
  sareeId   String            @map("saree_id")
  branchId  String            @map("branch_id")
  type      StockMovementType
  quantity  Int
  note      String?
  createdAt DateTime          @default(now()) @map("created_at")
  createdBy String            @map("created_by")

  saree  Saree  @relation(fields: [sareeId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
  user   User   @relation(fields: [createdBy], references: [id])

  @@map("stock_movements")
}

model Sale {
  id            String      @id @default(uuid())
  branchId      String      @map("branch_id")
  cashierId     String      @map("cashier_id")
  customerName  String?     @map("customer_name")
  customerPhone String?     @map("customer_phone")
  paymentMode   PaymentMode @default(CASH) @map("payment_mode")
  cashPaid      Decimal?    @map("cash_paid") @db.Decimal(10, 2)
  upiPaid       Decimal?    @map("upi_paid") @db.Decimal(10, 2)
  cardPaid      Decimal?    @map("card_paid") @db.Decimal(10, 2)
  upiReference  String?     @map("upi_reference")
  discount      Decimal     @default(0) @db.Decimal(10, 2)
  totalAmount   Decimal     @map("total_amount") @db.Decimal(10, 2)
  createdAt     DateTime    @default(now()) @map("created_at")

  branch  Branch         @relation(fields: [branchId], references: [id])
  cashier User           @relation(fields: [cashierId], references: [id])
  items   SaleItem[]
  returns ReturnRecord[]

  @@map("sales")
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String  @map("sale_id")
  sareeId   String  @map("saree_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(10, 2)

  sale  Sale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saree Saree @relation(fields: [sareeId], references: [id])

  @@map("sale_items")
}

model TransferRequest {
  id             String   @id @default(uuid())
  sourceBranchId String   @map("source_branch_id")
  targetBranchId String   @map("target_branch_id")
  sareeId        String   @map("saree_id")
  quantity       Int
  note           String?
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  sourceBranch Branch @relation("TransfersOut", fields: [sourceBranchId], references: [id])
  targetBranch Branch @relation("TransfersIn", fields: [targetBranchId], references: [id])
  saree        Saree  @relation(fields: [sareeId], references: [id])
  createdBy    User   @relation(fields: [createdById], references: [id])

  @@map("transfer_requests")
}

model ReturnRecord {
  id           String       @id @default(uuid())
  saleId       String       @map("sale_id")
  branchId     String       @map("branch_id")
  processedById String      @map("processed_by_id")
  refundAmount Decimal      @map("refund_amount") @db.Decimal(10, 2)
  reason       String?
  createdAt    DateTime     @default(now()) @map("created_at")

  sale         Sale         @relation(fields: [saleId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id])
  processedBy  User         @relation(fields: [processedById], references: [id])
  items        ReturnItem[]

  @@map("return_records")
}

model ReturnItem {
  id             String       @id @default(uuid())
  returnRecordId String       @map("return_record_id")
  sareeId        String       @map("saree_id")
  quantity       Int
  refundAmount   Decimal      @map("refund_amount") @db.Decimal(10, 2)

  returnRecord   ReturnRecord @relation(fields: [returnRecordId], references: [id], onDelete: Cascade)
  saree          Saree        @relation(fields: [sareeId], references: [id])

  @@map("return_items")
}

model DayClosure {
  id             String   @id @default(uuid())
  branchId       String   @map("branch_id")
  closedById     String   @map("closed_by_id")
  date           DateTime @default(now())
  totalSales     Decimal  @map("total_sales") @db.Decimal(10, 2)
  cashSales      Decimal  @map("cash_sales") @db.Decimal(10, 2)
  upiSales       Decimal  @map("upi_sales") @db.Decimal(10, 2)
  cardSales      Decimal  @map("card_sales") @db.Decimal(10, 2)
  actualCashInDrawer Decimal @map("actual_cash_in_drawer") @db.Decimal(10, 2)
  discrepancy    Decimal  @map("discrepancy") @db.Decimal(10, 2)
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")

  branch         Branch   @relation(fields: [branchId], references: [id])
  closedBy       User     @relation(fields: [closedById], references: [id])

  @@map("day_closures")
}
// END GENAI
