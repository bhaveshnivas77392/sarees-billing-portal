# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection strings (Project Settings > Database in the Supabase dashboard)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# Name shown on printed bills and the app header
NEXT_PUBLIC_SHOP_NAME="Sri Laxmi Narasimha Silk Sarees"

# Store UPI VPA for customer direct dynamic QR payments (0% gateway fees)
NEXT_PUBLIC_UPI_ID="srilaxminarasimhasarees@okaxis"
